---
import Layout from '../layouts/Layout.astro';
import { t, type Lang } from '../i18n/translations';

const langParam = Astro.url.searchParams.get('lang');
const validLangs: Lang[] = ['en', 'de', 'es', 'fr', 'ja', 'ru'];
const lang: Lang = validLangs.includes(langParam as Lang) ? (langParam as Lang) : 'en';
const T = t[lang];

const stepGradients = [
  { gradient: 'from-[#007cf0] to-[#00dfd8]', num: '01' },
  { gradient: 'from-[#7928ca] to-[#ff0080]', num: '02' },
  { gradient: 'from-[#ff4d4d] to-[#f9cb28]', num: '03' },
];

const featureIcons = [
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="8" stroke="#007cf0" stroke-width="1.5"/><circle cx="10" cy="10" r="4" stroke="#007cf0" stroke-width="1.5" stroke-dasharray="2 1.5"/><circle cx="10" cy="10" r="1.5" fill="#007cf0"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2" y="5" width="16" height="11" rx="2" stroke="#7928ca" stroke-width="1.5"/><path d="M6 9h8M6 12h5" stroke="#7928ca" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v14M3 10h14" stroke="#ff4d4d" stroke-width="1.5" stroke-linecap="round"/><circle cx="10" cy="10" r="7" stroke="#ff4d4d" stroke-width="1.5"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 14l4-4 3 3 5-6" stroke="#00dfd8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><rect x="2" y="2" width="16" height="16" rx="2" stroke="#00dfd8" stroke-width="1.5"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2a8 8 0 100 16A8 8 0 0010 2z" stroke="#f9cb28" stroke-width="1.5"/><path d="M10 6v4l3 2" stroke="#f9cb28" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="6" cy="7" r="3" stroke="#0070f3" stroke-width="1.5"/><circle cx="14" cy="7" r="3" stroke="#0070f3" stroke-width="1.5"/><path d="M1 17c0-3 2-5 5-5h2M11 12h2c3 0 5 2 5 5" stroke="#0070f3" stroke-width="1.5" stroke-linecap="round"/></svg>`,
];

const matrixFeatureLabels = ['SEO Analytics', 'Ad Monitoring', 'Review Tracking', 'Feature Comparison', 'Instant Results', 'No Email Gate', 'PDF Export', 'API Access'];
const matrixCompetitors = [
  { name: 'You', highlight: true,    values: [true,  false, false, true,  true,  true,  true,  true]  },
  { name: 'Comp. A', highlight: false, values: [true,  true,  true,  false, false, false, false, false] },
  { name: 'Comp. B', highlight: false, values: [true,  true,  false, false, false, false, true,  false] },
  { name: 'Comp. C', highlight: false, values: [true,  false, true,  false, true,  false, false, false] },
];

const pricingMeta = [
  { price: '$0', period: '', featured: false },
  { price: '$29', period: '/month', featured: true },
  { price: 'Custom', period: '', featured: false },
];
---

<Layout
  lang={lang}
  title="Competitor Finder — Find Competitors Website Free | findmycompetitor"
  description="The fastest competitor finder tool online. Paste your URL to find competitors website free, discover similar websites, and get an instant feature gap matrix — no email required."
  canonical="https://findmycompetitor.com/"
>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section id="hero" class="relative bg-canvas overflow-hidden" aria-labelledby="hero-heading">
    <div
      class="absolute inset-0 pointer-events-none"
      aria-hidden="true"
      style="background: radial-gradient(ellipse 80% 60% at 50% -10%, #007cf044 0%, #7928ca28 40%, #ff008018 65%, transparent 100%), radial-gradient(ellipse 60% 40% at 85% 15%, #00dfd820 0%, transparent 60%), radial-gradient(ellipse 40% 35% at 15% 25%, #f9cb2812 0%, transparent 60%);"
    ></div>

    <div class="relative max-w-[1400px] mx-auto px-4 sm:px-6 py-16 sm:py-24 md:py-40 text-center">
      <a
        href="#"
        class="inline-flex items-center gap-2 bg-canvas-soft text-body text-[14px] leading-5 tracking-[-0.28px] px-3 py-2 rounded-full border border-hairline mb-8 hover:border-hairline-strong transition-colors focus-visible:focus-ring"
      >
        <span class="font-mono text-[12px] text-link font-medium">New</span>
        {T.hero.pill}
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 6H9.5M7 3.5L9.5 6 7 8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <h1 id="hero-heading" class="text-[32px] sm:text-[40px] md:text-[48px] font-semibold leading-[1.1] tracking-[-1.6px] md:tracking-[-2.4px] text-ink max-w-3xl mx-auto mb-6 text-balance">
        {T.hero.h1}
      </h1>
      <p class="text-[16px] sm:text-[18px] leading-7 text-body max-w-xl mx-auto mb-10 text-balance">
        {T.hero.sub}
      </p>

      <form
        class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 max-w-2xl mx-auto mb-5"
        action="#" method="get" aria-label="Competitor finder"
      >
        <label for="hero-url" class="sr-only">Your website URL</label>
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-mute pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6.5 3.5L3 8l3.5 4.5M9.5 3.5L13 8l-3.5 4.5M5 8h6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <input
            id="hero-url" type="url" name="url" placeholder={T.hero.placeholder} autocomplete="url" required
            class="w-full h-12 pl-9 pr-4 bg-canvas text-ink text-[15px] leading-5 border border-hairline rounded-[8px] placeholder:text-mute focus-visible:outline-none focus-visible:border-ink focus-visible:ring-2 focus-visible:ring-ink/10 transition-colors"
            aria-describedby="hero-url-hint"
          />
        </div>
        <button type="submit" class="inline-flex items-center justify-center h-12 px-6 bg-primary text-on-primary text-[16px] font-medium leading-6 rounded-[100px] hover:opacity-80 transition-opacity focus-visible:focus-ring whitespace-nowrap shrink-0">
          {T.hero.cta}
        </button>
      </form>
      <p id="hero-url-hint" class="text-[13px] text-mute">{T.hero.hint}</p>
      <nav class="flex items-center justify-center gap-4 mt-4 flex-wrap" aria-label="Quick links">
        {[
          { label: 'About Us', href: '/about' },
          { label: 'Contact', href: '/contact' },
          { label: 'Privacy Policy', href: '/privacy-policy' },
          { label: 'Terms', href: '/terms' },
        ].map(link => (
          <a href={link.href} class="text-[12px] text-mute hover:text-ink transition-colors focus-visible:focus-ring rounded-sm">{link.label}</a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ── Analysis Results ─────────────────────────────────────── -->
  <section id="analysis-results" class="bg-canvas-soft border-y border-hairline py-12 hidden" aria-live="polite" aria-label="Analysis results">
    <div class="max-w-[900px] mx-auto px-4 sm:px-6">
      <!-- Loading state -->
      <div id="results-loading" class="hidden text-center py-16">
        <div class="relative inline-flex items-center justify-center mb-8">
          <svg class="animate-spin text-primary" width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.15"/>
            <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="absolute text-[18px]" aria-hidden="true" id="loading-icon">🔍</span>
        </div>
        <p id="loading-step-text" class="text-ink text-[16px] font-medium tracking-[-0.3px] mb-2">🔍 Scraping and parsing target website data...</p>
        <div class="flex items-center justify-center gap-1.5 mt-6">
          <span id="dot-1" class="w-2 h-2 rounded-full bg-primary opacity-100 transition-opacity duration-300"></span>
          <span id="dot-2" class="w-2 h-2 rounded-full bg-primary opacity-30 transition-opacity duration-300"></span>
          <span id="dot-3" class="w-2 h-2 rounded-full bg-primary opacity-30 transition-opacity duration-300"></span>
          <span id="dot-4" class="w-2 h-2 rounded-full bg-primary opacity-30 transition-opacity duration-300"></span>
        </div>
        <p class="text-mute text-[12px] mt-4 font-mono">This takes about 15–30 seconds</p>
      </div>
      <!-- Error state -->
      <div id="results-error" class="hidden rounded-[8px] border p-5 text-[14px]"></div>
      <!-- Output -->
      <div id="results-output" class="hidden">
        <div class="flex items-center justify-between gap-4 mb-6 flex-wrap">
          <h2 class="text-[22px] font-semibold tracking-[-0.8px] text-ink">Competitor Analysis Results</h2>
          <div class="flex items-center gap-2 no-print">
            <button id="export-csv-btn" type="button" class="inline-flex items-center gap-1.5 h-9 px-4 text-[13px] font-medium border border-hairline rounded-[6px] text-body hover:text-ink hover:border-hairline-strong transition-colors focus-visible:focus-ring">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v8M4 6l3 3 3-3M2 10v1a1 1 0 001 1h8a1 1 0 001-1v-1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Export CSV
            </button>
            <button id="export-pdf-btn" type="button" class="inline-flex items-center gap-1.5 h-9 px-4 text-[13px] font-medium bg-primary text-on-primary rounded-[6px] hover:opacity-80 transition-opacity focus-visible:focus-ring">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="2" y="1" width="10" height="12" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M4 5h6M4 7.5h6M4 10h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              Export PDF
            </button>
          </div>
        </div>
        <!-- Target summary -->
        <div id="results-summary" class="mb-8 bg-canvas rounded-[8px] border border-hairline p-5 grid grid-cols-1 sm:grid-cols-2 gap-4 text-[14px]"></div>
        <!-- Competitors list -->
        <h3 class="text-[16px] font-semibold text-ink mb-3">Top Competitors</h3>
        <ul id="results-competitors" class="list-none m-0 p-0 mb-8 flex flex-col gap-3"></ul>
        <!-- Gap matrix -->
        <h3 class="text-[16px] font-semibold text-ink mb-3">Feature Gap Matrix</h3>
        <div class="overflow-x-auto rounded-[8px] border border-hairline">
          <table id="results-matrix" class="w-full text-[13px] border-collapse">
            <thead><tr id="results-matrix-head" class="border-b border-hairline bg-canvas-soft"></tr></thead>
            <tbody id="results-matrix-body"></tbody>
          </table>
        </div>
        <!-- Analyze another URL -->
        <div class="mt-8 pt-6 border-t border-hairline">
          <p class="text-[13px] text-mute mb-3">Analyze another website</p>
          <form class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3" aria-label="Competitor finder inline">
            <div class="relative flex-1">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-mute pointer-events-none" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M6.5 3.5L3 8l3.5 4.5M9.5 3.5L13 8l-3.5 4.5M5 8h6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <input type="url" name="url" placeholder="https://yourwebsite.com" autocomplete="url" required
                class="w-full h-11 pl-9 pr-4 bg-canvas text-ink text-[15px] border border-hairline rounded-[8px] placeholder:text-mute focus-visible:outline-none focus-visible:border-ink focus-visible:ring-2 focus-visible:ring-ink/10 transition-colors"
              />
            </div>
            <button type="submit" class="inline-flex items-center justify-center h-11 px-5 bg-primary text-on-primary text-[15px] font-medium rounded-[100px] hover:opacity-80 transition-opacity focus-visible:focus-ring whitespace-nowrap shrink-0">
              Analyze
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Social logos strip ─────────────────────────────────────── -->
  <div class="bg-canvas border-y border-hairline py-6 no-print">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
      <p class="text-center font-mono text-[12px] text-mute uppercase tracking-wider mb-5">{T.logos.label}</p>
      <ul class="flex items-center justify-center gap-6 sm:gap-10 flex-wrap list-none m-0 p-0" role="list" aria-label="Customer companies">
        {['Storylane', 'Opnform', 'Launchpad', 'Peerlist', 'Tally', 'Rowy'].map(name => (
          <li><span class="text-[14px] text-hairline-strong font-semibold tracking-[-0.28px]" translate="no">{name}</span></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- ── How It Works ──────────────────────────────────────────────── -->
  <section id="how-it-works" class="bg-canvas py-16 sm:py-24 md:py-32" aria-labelledby="how-heading">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
      <p class="font-mono text-[12px] text-mute uppercase tracking-wider mb-4 text-center" aria-hidden="true">{T.how.eyebrow}</p>
      <h2 id="how-heading" class="text-[24px] sm:text-[32px] font-semibold leading-tight tracking-[-1.28px] text-ink text-center mb-12 text-balance max-w-2xl mx-auto">
        {T.how.h2}
      </h2>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 list-none m-0 p-0" role="list">
        {T.steps.map((step, i) => (
          <li class="bg-canvas rounded-[12px] p-8 shadow-card-lg flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <span class={`font-mono text-[11px] font-medium px-2 py-1 rounded-full bg-gradient-to-r ${stepGradients[i].gradient} text-white`}>{step.eyebrow}</span>
              <span class="font-mono text-[12px] text-mute">{stepGradients[i].num}</span>
            </div>
            <h3 class="text-[20px] font-semibold leading-7 tracking-[-0.6px] text-ink text-balance">{step.title}</h3>
            <p class="text-[15px] leading-6 text-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Feature Gap Matrix Preview ──────────────────────────────── -->
  <section class="bg-canvas-soft py-16 sm:py-24 md:py-32" id="features" aria-labelledby="matrix-heading">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
      <p class="font-mono text-[12px] text-mute uppercase tracking-wider mb-4 text-center" aria-hidden="true">{T.matrix.eyebrow}</p>
      <h2 id="matrix-heading" class="text-[24px] sm:text-[32px] font-semibold leading-tight tracking-[-1.28px] text-ink text-center mb-4 text-balance max-w-2xl mx-auto">
        {T.matrix.h2}
      </h2>
      <p class="text-[16px] sm:text-[18px] leading-7 text-body text-center max-w-xl mx-auto mb-10 sm:mb-14 text-balance">
        {T.matrix.sub}
      </p>
      <div class="overflow-x-auto rounded-[12px] shadow-card-lg bg-canvas" role="region" aria-label="Feature gap matrix preview">
        <table class="w-full min-w-[560px] text-[13px]" aria-label="Competitor feature comparison">
          <thead>
            <tr class="border-b border-hairline">
              <th scope="col" class="text-left font-mono text-[11px] text-mute uppercase tracking-wider px-5 py-3 w-44">Feature</th>
              {matrixCompetitors.map(c => (
                <th scope="col" class={`text-center font-semibold text-[13px] px-4 py-3 tracking-[-0.28px] ${c.highlight ? 'text-link' : 'text-ink'}`}>
                  {c.highlight ? (
                    <span class="inline-flex items-center gap-1.5">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><circle cx="6" cy="6" r="5" stroke="#3b9eff" stroke-width="1.5"/><path d="M4 6l1.5 1.5L8 4" stroke="#3b9eff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {c.name}
                    </span>
                  ) : c.name}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {matrixFeatureLabels.map((feat, fi) => (
              <tr class={`border-b border-hairline last:border-0 ${fi % 2 === 0 ? 'bg-canvas' : 'bg-canvas-soft/60'}`}>
                <td class="px-5 py-3 text-body text-[13px] leading-5 font-medium tracking-[-0.2px]">{feat}</td>
                {matrixCompetitors.map(c => (
                  <td class="px-4 py-3 text-center">
                    {c.values[fi] ? (
                      <svg class="inline-block" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-label="Supported" role="img">
                        <circle cx="8" cy="8" r="7" fill={c.highlight ? '#3b9eff' : 'currentColor'} fill-opacity={c.highlight ? '1' : '0.12'}/>
                        <path d="M5 8l2 2 4-4" stroke={c.highlight ? '#fff' : 'currentColor'} stroke-opacity={c.highlight ? '1' : '0.5'} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    ) : (
                      <svg class="inline-block" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-label="Not supported" role="img">
                        <circle cx="8" cy="8" r="7" fill="currentColor" fill-opacity="0.07"/>
                        <path d="M6 6l4 4M10 6l-4 4" stroke="currentColor" stroke-opacity="0.25" stroke-width="1.4" stroke-linecap="round"/>
                      </svg>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-center text-[13px] text-mute mt-5">{T.matrix.note}</p>
    </div>
  </section>

  <!-- ── Feature grid ──────────────────────────────────────────────── -->
  <section class="bg-canvas py-16 sm:py-24 md:py-32" aria-labelledby="feature-grid-heading">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
      <p class="font-mono text-[12px] text-mute uppercase tracking-wider mb-4 text-center" aria-hidden="true">{T.features.eyebrow}</p>
      <h2 id="feature-grid-heading" class="text-[24px] sm:text-[32px] font-semibold leading-tight tracking-[-1.28px] text-ink text-center mb-10 sm:mb-14 text-balance max-w-2xl mx-auto">
        {T.features.h2}
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5 list-none m-0 p-0" role="list">
        {T.featureCards.map((f, i) => (
          <li class="bg-canvas-soft rounded-[8px] p-6 shadow-card">
            <div class="mb-3" set:html={featureIcons[i]}></div>
            <h3 class="text-[16px] font-semibold leading-6 tracking-[-0.4px] text-ink mb-2 flex items-center gap-2 flex-wrap">
              {f.title}
              {(i === 4 || i === 5) && (
                <span class="inline-block px-[6px] py-[2px] text-[10px] font-semibold leading-none tracking-wide uppercase rounded-[3px] bg-[#1a0000] border border-[#ff2020]/40 text-[#ff2020]" style="box-shadow: 0 0 6px rgba(255,32,32,0.25);">Available Soon</span>
              )}
            </h3>
            <p class="text-[14px] leading-5 text-body">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Dark band — Auto-Scrape demo ─────────────────────────────── -->
  <section class="dark-band py-16 sm:py-24 md:py-32" aria-labelledby="autoscrape-heading">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6">

      <!-- Row 1: Step 1 (left) + Step 2 (right) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 mb-12 md:mb-16">

        <!-- Step 1 -->
        <div>
          <p class="font-mono text-[12px] dark:text-white/40 text-ink/50 uppercase tracking-wider mb-4" aria-hidden="true">{T.scrape.eyebrow}</p>
          <h2 id="autoscrape-heading" class="text-[22px] sm:text-[28px] font-semibold leading-tight tracking-[-1.12px] dark:text-white text-ink mb-3 text-balance">
            {T.scrape.h2}
          </h2>
          <p class="text-[15px] sm:text-[16px] leading-6 dark:text-white/70 text-body mb-8 text-balance">
            {T.scrape.sub}
          </p>
          <div class="bg-[#0d0d0d] dark:bg-[#0d0d0d] rounded-[8px] p-6 border border-white/10 overflow-x-auto" role="img" aria-label="Auto-scrape AI output example">
            <pre class="font-mono text-[13px] leading-6 text-white/80 m-0 whitespace-pre-wrap"><code><span class="text-[#888]">→ Scraping https://yourwebsite.com...</span>
<span class="text-[#00dfd8]">✓ Title:</span>       <span class="text-white">Your SaaS Product — Smart Forms for Teams</span>
<span class="text-[#00dfd8]">✓ Category:</span>    <span class="text-white">Form Builder / No-Code Tools</span>
<span class="text-[#00dfd8]">✓ Audience:</span>    <span class="text-white">Product teams, developers, SMBs</span>
<span class="text-[#00dfd8]">✓ Key features:</span> <span class="text-white">Drag-and-drop, Conditional Logic, API</span>
<span class="text-[#007cf0]">→ Finding competitors...</span>
<span class="text-[#f9cb28]">✓ Found 14 competitors</span>  <span class="text-[#888]">in 8.3s</span>
<span class="text-[#f9cb28]">✓ Gap matrix ready</span>      <span class="text-[#888]">48 features analyzed</span></code></pre>
          </div>
        </div>

        <!-- Step 2 -->
        <div>
          <p class="font-mono text-[12px] dark:text-white/40 text-ink/50 uppercase tracking-wider mb-4" aria-hidden="true">{T.scrape.step2Title}</p>
          <h2 class="text-[22px] sm:text-[28px] font-semibold leading-tight tracking-[-1.12px] dark:text-white text-ink mb-3 text-balance">
            {T.scrape.step2Title.split('—').slice(1).join('—').trim()}
          </h2>
          <p class="text-[15px] sm:text-[16px] leading-6 dark:text-white/70 text-body mb-8 text-balance">
            {T.scrape.step2Body}
          </p>
          <div class="bg-[#0d0d0d] rounded-[8px] p-6 border border-white/10 overflow-x-auto" role="img" aria-label="Discovery step example">
            <pre class="font-mono text-[13px] leading-6 text-white/80 m-0 whitespace-pre-wrap"><code><span class="text-[#888]">→ Cross-referencing sources...</span>
<span class="text-[#00dfd8]">✓ G2 / Capterra:</span>   <span class="text-white">8 matches found</span>
