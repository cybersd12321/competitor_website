  <!-- ── Print Frame (visible only during print/PDF export) ──────── -->
  <div id="print-frame" class="hidden" aria-hidden="true"></div>

  <script>
    const section = document.getElementById('analysis-results')!;
    const loading = document.getElementById('results-loading')!;
    const errorEl = document.getElementById('results-error')!;
    const output = document.getElementById('results-output')!;
    const summaryEl = document.getElementById('results-summary')!;
    const competitorsList = document.getElementById('results-competitors')!;
    const matrixHead = document.getElementById('results-matrix-head')!;
    const matrixBody = document.getElementById('results-matrix-body')!;
    const stepText = document.getElementById('loading-step-text')!;
    const dots = [1, 2, 3, 4].map(n => document.getElementById(`dot-${n}`)!);

    let lastSearchedUrl = '';

    function show(el: HTMLElement) { el.classList.remove('hidden'); }
    function hide(el: HTMLElement) { el.classList.add('hidden'); }

    const STATUS_MAP: Record<string, { text: string; dot: number }> = {
      scraping:   { text: '🔍 Scraping and parsing target website data...', dot: 0 },
      searching:  { text: '🌐 Initiating real-time search index queries...', dot: 1 },
      analyzing:  { text: '🧠 Contextualizing competitor semantics via LLM...', dot: 2 },
      complete:   { text: '📊 Compiling feature matrix and gap analysis...', dot: 3 },
    };

    function updateStep(status: string, message?: string) {
      const step = STATUS_MAP[status];
      if (!step) return;
      stepText.textContent = message ?? step.text;
      dots.forEach((d, i) => { d.style.opacity = i <= step.dot ? '1' : '0.3'; });
    }

    const CHECK_SVG = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-label="Yes" class="inline-block"><circle cx="8" cy="8" r="7" fill="#3b9eff" fill-opacity="0.15"/><path d="M5 8l2 2 4-4" stroke="#3b9eff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    const CROSS_SVG = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-label="No" class="inline-block"><circle cx="8" cy="8" r="7" fill="currentColor" fill-opacity="0.07"/><path d="M6 6l4 4M10 6l-4 4" stroke="currentColor" stroke-opacity="0.3" stroke-width="1.4" stroke-linecap="round"/></svg>';

    function renderResults(analysis: any) {
      summaryEl.innerHTML = `
        <div><p class="text-mute font-mono text-[11px] uppercase tracking-wider mb-1">Audience</p><p class="text-ink">${analysis.target_summary.audience}</p></div>
        <div><p class="text-mute font-mono text-[11px] uppercase tracking-wider mb-1">Monetization</p><p class="text-ink">${analysis.target_summary.monetization}</p></div>
      `;

      competitorsList.innerHTML = analysis.competitors.map((c: any) => `
        <li class="flex items-start justify-between gap-4 bg-canvas rounded-[8px] border border-hairline p-4">
          <div>
            <a href="${c.url}" target="_blank" rel="noopener noreferrer" class="font-semibold text-link hover:underline text-[15px]">${c.name}</a>
            <p class="text-body text-[13px] mt-1">${c.description}</p>
          </div>
          <span class="shrink-0 font-mono text-[12px] bg-primary/10 text-primary rounded-full px-2 py-0.5">${c.match_score}% match</span>
        </li>
      `).join('');

      const compNames: string[] = analysis.competitors.map((c: any) => c.name);
      matrixHead.innerHTML = `
        <th class="text-left px-4 py-3 text-mute font-mono text-[11px] uppercase tracking-wider">Feature</th>
        <th class="px-4 py-3 text-center text-[12px] font-semibold text-link">You</th>
        ${compNames.map((n: string) => `<th class="px-4 py-3 text-center text-[12px] font-semibold text-ink">${n}</th>`).join('')}
      `;

      matrixBody.innerHTML = analysis.matrix.map((row: any, i: number) => {
        const cells = [row.target_has, ...(row.competitor_values ?? []).map((v: boolean) => v)]
          .map((has: boolean) => `<td class="px-4 py-3 text-center">${has ? CHECK_SVG : CROSS_SVG}</td>`)
          .join('');
        return `
          <tr class="${i % 2 === 0 ? 'bg-canvas' : 'bg-canvas-soft/60'} border-b border-hairline last:border-0">
            <td class="px-4 py-3 text-body text-[13px] font-medium">${row.feature_name}${row.is_gap ? ' <span class="text-[10px] font-mono bg-yellow-100 text-yellow-700 rounded px-1 ml-1">gap</span>' : ''}</td>
            ${cells}
          </tr>`;
      }).join('');
    }

    function showError(message: string, isUnavailable = false) {
      hide(loading);
      if (isUnavailable) {
        errorEl.className = 'rounded-[8px] border border-amber-200 bg-amber-50 p-5 text-[14px] text-amber-800';
        errorEl.innerHTML = `
          <p class="font-semibold mb-1">⏳ We're experiencing temporary high demand</p>
          <p class="text-amber-700">Our AI service is currently overloaded. This is usually short-lived — please wait a moment and try again.</p>
        `;
      } else {
        errorEl.className = 'rounded-[8px] border border-red-200 bg-red-50 p-5 text-[14px] text-red-700';
        errorEl.textContent = message || 'Something went wrong. Please try again.';
      }
      show(errorEl);
    }

    async function handleSubmit(e: SubmitEvent) {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const url = (form.querySelector('input[type="url"]') as HTMLInputElement).value.trim();
      if (!url) return;

      lastSearchedUrl = url;
      show(section);
      show(loading);
      hide(errorEl);
      hide(output);
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      updateStep('scraping');

      let res: Response;
      try {
        res = await fetch('/api/analyze', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url }),
        });
      } catch {
        showError('Network error — could not reach the server.');
        return;
      }

      if (!res.ok || !res.body) {
        showError(`Server error: ${res.status}`);
        return;
      }

      const reader = res.body.pipeThrough(new TextDecoderStream()).getReader();
      let buffer = '';

      try {
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          buffer += value;
          const lines = buffer.split('\n');
          buffer = lines.pop() ?? '';   // keep incomplete last line

          for (const line of lines) {
            if (!line.startsWith('data: ')) continue;
            let event: any;
            try { event = JSON.parse(line.slice(6)); } catch { continue; }

            const { status, message, payload } = event;

            if (status === 'error') {
              showError(message);
              reader.cancel();
              return;
            }

            if (status === 'complete') {
              updateStep('complete');
              renderResults(payload.analysis);
              hide(loading);
              show(output);
              reader.cancel();
              return;
            }

            if (status === 'routing') {
              stepText.textContent = message;
              return;
            }

            // scraping | searching | analyzing — update indicator
            updateStep(status, message);
          }
        }
      } catch {
        showError('Stream interrupted. Please try again.');
      }
    }

    document.addEventListener('submit', (e) => {
      const form = e.target as HTMLFormElement;
      if (form.getAttribute('aria-label')?.startsWith('Competitor finder')) {
        handleSubmit(e as SubmitEvent);
      }
    });

    // ── Export CSV ──────────────────────────────────────────────────
    document.getElementById('export-csv-btn')!.addEventListener('click', () => {
      const rows: string[][] = [];

      // Branding header
      rows.push(['findmycompetitor.com — Competitor Analysis Report']);
      rows.push([`Analyzed URL: ${lastSearchedUrl}`]);
      rows.push([`Generated: ${new Date().toLocaleString()}`]);
      rows.push([]);

      // Matrix header row
      const thCells = Array.from(matrixHead.querySelectorAll('th'));
      rows.push(thCells.map(th => th.textContent?.trim() ?? ''));

      // Data rows
      Array.from(matrixBody.querySelectorAll('tr')).forEach(tr => {
        const cells = Array.from(tr.querySelectorAll('td')).map(td => {
          const svg = td.querySelector('svg');
          if (svg) return svg.getAttribute('aria-label') === 'Yes' ? 'Yes' : 'No';
          return td.textContent?.trim() ?? '';
        });
        rows.push(cells);
      });

      const csv = rows.map(r => r.map(c => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'findmycompetitor-analysis.csv';
      a.click();
      URL.revokeObjectURL(a.href);
    });

    // ── Export PDF ──────────────────────────────────────────────────
    document.getElementById('export-pdf-btn')!.addEventListener('click', () => {
      // Build matrix table HTML
      const thCells = Array.from(matrixHead.querySelectorAll('th')).map(th => th.textContent?.trim() ?? '');
      const tableRows = Array.from(matrixBody.querySelectorAll('tr')).map(tr =>
        Array.from(tr.querySelectorAll('td')).map(td => {
          const svg = td.querySelector('svg');
          if (svg) return svg.getAttribute('aria-label') === 'Yes' ? '✓' : '✗';
          return td.textContent?.trim() ?? '';
        })
      );

      const theadHtml = `<tr>${thCells.map(t => `<th>${t}</th>`).join('')}</tr>`;
      const tbodyHtml = tableRows.map(row =>
        `<tr>${row.map((cell, i) => `<td style="${i > 0 ? 'text-align:center;' : ''} color:${cell === '✓' ? '#0070f3' : cell === '✗' ? '#aaa' : 'inherit'}">${cell}</td>`).join('')}</tr>`
      ).join('');

      // Competitors list HTML
      const compItems = Array.from(competitorsList.querySelectorAll('li')).map(li => {
        const name = li.querySelector('a')?.textContent?.trim() ?? '';
        const url = li.querySelector('a')?.getAttribute('href') ?? '';
        const desc = li.querySelector('p')?.textContent?.trim() ?? '';
        const score = li.querySelector('span')?.textContent?.trim() ?? '';
        return `<tr><td><strong>${name}</strong><br><small style="color:#555">${url}</small></td><td style="color:#555;font-size:12px">${desc}</td><td style="text-align:center;color:#0070f3;font-weight:600">${score}</td></tr>`;
      }).join('');

      const printFrame = document.getElementById('print-frame')!;
      printFrame.innerHTML = `
        <div style="font-family:system-ui,sans-serif;color:#111;max-width:100%">
          <!-- Branding header -->
          <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid #0070f3;padding-bottom:12px;margin-bottom:20px">
            <div style="display:flex;align-items:center;gap:8px">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#0070f3" stroke-width="1.5"/><circle cx="12" cy="12" r="6" stroke="#0070f3" stroke-width="1.5" stroke-dasharray="3 2"/><circle cx="12" cy="12" r="2" fill="#0070f3"/><line x1="12" y1="12" x2="20" y2="6" stroke="#3b9eff" stroke-width="1.5" stroke-linecap="round"/></svg>
              <span style="font-size:18px;font-weight:700;letter-spacing:-0.5px;color:#111">findmycompetitor.com</span>
            </div>
            <span style="font-size:11px;color:#888">Generated ${new Date().toLocaleString()}</span>
          </div>

          <h1 style="font-size:16px;font-weight:600;margin:0 0 6px 0">Competitor Analysis Report</h1>
          <p style="font-size:12px;color:#555;margin:0 0 20px 0">Analyzed URL: <strong style="color:#0070f3">${lastSearchedUrl}</strong></p>

          <h2 style="font-size:13px;font-weight:600;margin:0 0 8px 0;text-transform:uppercase;letter-spacing:0.5px;color:#555">Top Competitors</h2>
          <table style="width:100%;border-collapse:collapse;margin-bottom:24px;font-size:12px">
            <thead><tr style="background:#f5f5f5"><th style="padding:6px 10px;border:1px solid #ddd;text-align:left">Name &amp; URL</th><th style="padding:6px 10px;border:1px solid #ddd;text-align:left">Description</th><th style="padding:6px 10px;border:1px solid #ddd;text-align:center">Match</th></tr></thead>
            <tbody>${compItems}</tbody>
          </table>

          <h2 style="font-size:13px;font-weight:600;margin:0 0 8px 0;text-transform:uppercase;letter-spacing:0.5px;color:#555">Feature Gap Matrix</h2>
          <table style="width:100%;border-collapse:collapse;font-size:11px">
            <thead>${theadHtml}</thead>
            <tbody>${tbodyHtml}</tbody>
          </table>

          <p style="font-size:10px;color:#aaa;margin-top:20px;text-align:center">findmycompetitor.com — Free AI Competitor Intelligence Tool</p>
        </div>
      `;

      window.print();
    });
  </script>

</Layout>
