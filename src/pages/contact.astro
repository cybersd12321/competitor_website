---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us | findmycompetitor"
  description="Get in touch with the findmycompetitor team. We're happy to help with questions, feedback, or partnership inquiries."
  canonical="https://findmycompetitor.com/contact"
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
    <h1 class="text-[28px] sm:text-[36px] font-semibold leading-tight tracking-[-1px] text-ink mb-4">Contact Us</h1>
    <p class="text-[16px] leading-7 text-body mb-10">Have a question, feedback, or partnership inquiry? We'd love to hear from you.</p>

    <form
      name="contact"
      method="POST"
      action="/contact?success=true"
      class="space-y-5"
      aria-label="Contact form"
    >
      <div>
        <label for="name" class="block text-[13px] font-medium text-ink mb-1.5">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder="Your name"
          class="w-full h-10 px-3 bg-canvas border border-hairline rounded-[6px] text-[14px] text-ink placeholder:text-mute focus:outline-none focus:border-link transition-colors"
        />
      </div>

      <div>
        <label for="email" class="block text-[13px] font-medium text-ink mb-1.5">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="w-full h-10 px-3 bg-canvas border border-hairline rounded-[6px] text-[14px] text-ink placeholder:text-mute focus:outline-none focus:border-link transition-colors"
        />
      </div>

      <div>
        <label for="subject" class="block text-[13px] font-medium text-ink mb-1.5">Subject</label>
        <select
          id="subject"
          name="subject"
          class="w-full h-10 px-3 bg-canvas border border-hairline rounded-[6px] text-[14px] text-ink focus:outline-none focus:border-link transition-colors"
        >
          <option value="general">General question</option>
          <option value="feedback">Feedback</option>
          <option value="bug">Bug report</option>
          <option value="partnership">Partnership / Business</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-[13px] font-medium text-ink mb-1.5">Message</label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          placeholder="Tell us how we can help…"
          class="w-full px-3 py-2.5 bg-canvas border border-hairline rounded-[6px] text-[14px] text-ink placeholder:text-mute focus:outline-none focus:border-link transition-colors resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="flex items-center h-10 px-5 bg-primary text-on-primary text-[14px] font-medium rounded-[6px] hover:opacity-80 transition-opacity focus-visible:focus-ring"
      >
        Send message
      </button>
    </form>

    {Astro.url.searchParams.get('success') === 'true' && (
      <div role="alert" class="mt-6 p-4 bg-canvas-soft border border-hairline rounded-[8px] text-[14px] text-ink">
        ✓ Message sent! We'll get back to you within 1–2 business days.
      </div>
    )}

    <div class="mt-12 pt-8 border-t border-hairline">
      <p class="text-[13px] text-mute">Prefer email? Reach us directly at <a href="mailto:hello@findmycompetitor.com" class="text-link hover:underline">hello@findmycompetitor.com</a></p>
    </div>
  </div>
</Layout>
