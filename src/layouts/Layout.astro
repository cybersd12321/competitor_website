---
import '../styles/global.css';
import { t, languages, type Lang } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  canonical?: string;
  ogImage?: string;
}
const {
  lang = 'en',
  title = 'Competitor Finder — Find Competitors Website Free | findmycompetitor',
  description = 'Use our free competitor finder to find competitors website instantly. Discover similar websites, get a full feature gap matrix, and analyze your market — no email required.',
  canonical = 'https://findmycompetitor.com/',
  ogImage = 'https://findmycompetitor.com/og-image.png',
} = Astro.props;

const T = t[lang];
const navLinks = [
  { label: T.nav.features, href: '#features' },
  { label: T.nav.howItWorks, href: '#how-it-works' },
  { label: T.nav.faq, href: '#faq' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="competitor finder, competitor website finder, find competitors website free, find similar websites, similar website finder, AI competitor analysis, competitor research tool" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="findmycompetitor" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="findmycompetitor" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : lang} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "findmycompetitor",
      "url": "https://findmycompetitor.com/",
      "description": description,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    })} />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BZBR1CVDBK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BZBR1CVDBK');
    </script>

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-canvas-soft text-ink antialiased">

    <!-- Skip link -->
    <a
      href="#main-content"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-2 focus-visible:left-2 focus-visible:z-[100] focus-visible:bg-canvas focus-visible:text-ink focus-visible:px-3 focus-visible:py-2 focus-visible:rounded-sm focus-visible:shadow-card focus-visible:text-sm"
    >
      Skip to main content
    </a>

    <!-- Nav -->
    <header class="sticky top-0 z-50 bg-canvas/95 backdrop-blur border-b border-hairline">
      <nav class="max-w-[1400px] mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-4 sm:gap-6" aria-label="Main navigation">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 shrink-0 focus-visible:focus-ring rounded-sm" aria-label="findmycompetitor home">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2"/>
            <circle cx="12" cy="12" r="2" fill="currentColor"/>
            <line x1="12" y1="12" x2="20" y2="6" stroke="#3b9eff" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="text-[15px] font-semibold leading-5 tracking-[-0.4px] text-ink">findmycompetitor</span>
        </a>

        <!-- Center links (desktop) -->
        <ul class="hidden md:flex items-center gap-1 list-none m-0 p-0" role="list">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="text-body text-[14px] leading-5 tracking-[-0.28px] px-3 py-2 rounded-full hover:text-ink hover:bg-canvas-soft-2 transition-colors focus-visible:focus-ring"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Right controls -->
        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">

          <!-- Dark mode toggle -->
          <button
            id="theme-toggle"
            type="button"
            aria-label={T.darkToggle}
            title={T.darkToggle}
            class="flex items-center justify-center w-8 h-8 rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 transition-colors focus-visible:focus-ring"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg id="icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="hidden dark:block">
              <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.4"/>
              <path d="M8 1v1.5M8 13.5V15M15 8h-1.5M2.5 8H1M12.36 3.64l-1.06 1.06M4.7 11.3l-1.07 1.07M12.36 12.36l-1.06-1.06M4.7 4.7L3.63 3.63" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="block dark:hidden">
              <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <!-- Language switcher -->
          <div class="relative" id="lang-dropdown-container">
            <button
              id="lang-toggle"
              type="button"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-label="Select language"
              class="hidden sm:flex items-center gap-1.5 h-8 px-2.5 bg-canvas border border-hairline rounded-md text-body text-[13px] font-medium hover:bg-canvas-soft-2 transition-colors focus-visible:focus-ring"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.3"/>
                <path d="M7 1C7 1 5 3.5 5 7s2 6 2 6M7 1c0 0 2 2.5 2 6s-2 6-2 6M1 7h12" stroke="currentColor" stroke-width="1.3"/>
              </svg>
              <span id="current-lang-label">{languages[lang]}</span>
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <!-- Dropdown -->
            <ul
              id="lang-menu"
              role="listbox"
              aria-label="Language options"
              class="hidden absolute right-0 top-full mt-1.5 bg-canvas border border-hairline rounded-[8px] shadow-card-lg py-1 min-w-[140px] z-50 list-none m-0 p-1"
            >
              {Object.entries(languages).map(([code, name]) => (
                <li role="option" aria-selected={code === lang}>
                  <button
                    data-lang={code}
                    class={`lang-option w-full text-left px-3 py-2 text-[13px] rounded-md transition-colors hover:bg-canvas-soft-2 focus-visible:focus-ring ${code === lang ? 'text-link font-medium' : 'text-body'}`}
                  >
                    {name}
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <a href="#hero" class="flex items-center h-7 px-2 bg-primary text-on-primary text-[14px] font-medium leading-5 tracking-[-0.28px] rounded-[6px] hover:opacity-80 transition-opacity focus-visible:focus-ring">
            {T.nav.tryFree}
          </a>

          <!-- Mobile hamburger -->
          <button
            id="nav-toggle"
            type="button"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label="Open navigation menu"
            class="md:hidden flex items-center justify-center w-8 h-8 rounded-sm hover:bg-canvas-soft-2 transition-colors focus-visible:focus-ring"
          >
            <svg id="icon-menu" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M2 4h14M2 9h14M2 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <svg id="icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" class="hidden">
              <path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </nav>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        role="dialog"
        aria-label="Navigation menu"
        aria-modal="true"
        class="hidden md:hidden bg-canvas border-t border-hairline px-4 sm:px-6 py-4"
      >
        <ul class="flex flex-col gap-1 list-none m-0 p-0" role="list">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="block text-body text-[14px] leading-5 tracking-[-0.28px] px-3 py-2 rounded-md hover:text-ink hover:bg-canvas-soft-2 transition-colors focus-visible:focus-ring"
              >
                {link.label}
              </a>
            </li>
          ))}
          <li class="mt-3 pt-3 border-t border-hairline flex flex-wrap gap-2">
            <a href="#hero" class="flex items-center h-9 px-4 bg-primary text-on-primary text-[14px] font-medium rounded-[6px] hover:opacity-80 transition-opacity focus-visible:focus-ring">{T.nav.tryFree}</a>
            <!-- Mobile lang switcher -->
            <div class="flex flex-wrap gap-1 mt-2 w-full">
              {Object.entries(languages).map(([code, name]) => (
                <button
                  data-lang={code}
                  class={`lang-option px-2 py-1 text-[12px] rounded border transition-colors focus-visible:focus-ring ${code === lang ? 'border-link text-link font-medium bg-link-bg-soft' : 'border-hairline text-body hover:bg-canvas-soft-2'}`}
                >
                  {name}
                </button>
              ))}
            </div>
          </li>
        </ul>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-canvas border-t border-hairline" aria-label="Site footer">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 py-10 sm:py-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 mb-10 sm:mb-12">
          <!-- Brand col -->
          <div class="col-span-2 md:col-span-1">
            <a href="/" class="flex items-center gap-2 mb-4 focus-visible:focus-ring rounded-sm w-fit" aria-label="findmycompetitor home">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2"/>
                <circle cx="12" cy="12" r="2" fill="currentColor"/>
                <line x1="12" y1="12" x2="20" y2="6" stroke="#3b9eff" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <span class="text-[14px] font-semibold text-ink">findmycompetitor</span>
            </a>
            <p class="text-[12px] text-mute leading-4">{T.footer.copy}</p>
            <p class="text-[12px] text-mute leading-4 mt-1">{T.footer.tagline}</p>
          </div>
          <!-- Link cols -->
          {T.footerCols.map((col, colIdx) => (
            <nav aria-label={`${col.heading} links`}>
              <p class="font-mono text-[12px] leading-4 text-ink font-medium uppercase tracking-wider mb-3">{col.heading}</p>
              <ul class="space-y-2 list-none m-0 p-0" role="list">
                {col.links.map((link, linkIdx) => {
                  // Company col (index 2): map links by position to real pages
                  const companyHrefs = ['/about', '/contact', '/privacy-policy', '/terms'];
                  const href = colIdx === 2 ? (companyHrefs[linkIdx] ?? '#') : '#';
                  return (
                    <li>
                      <a href={href} class="text-[14px] text-body leading-5 tracking-[-0.28px] hover:text-ink transition-colors focus-visible:focus-ring rounded-sm">{link}</a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          ))}
        </div>
      </div>
    </footer>

    <script>
      // ── Mobile menu toggle ────────────────────────────────────────
      const navToggle = document.getElementById('nav-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconMenuEl = document.getElementById('icon-menu');
      const iconCloseEl = document.getElementById('icon-close');
      navToggle?.addEventListener('click', () => {
        const isOpen = !mobileMenu?.classList.contains('hidden');
        mobileMenu?.classList.toggle('hidden');
        navToggle.setAttribute('aria-expanded', String(!isOpen));
        navToggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
        iconMenuEl?.classList.toggle('hidden', !isOpen);
        iconCloseEl?.classList.toggle('hidden', isOpen);
      });

      // ── Dark mode toggle ──────────────────────────────────────────
      const themeToggle = document.getElementById('theme-toggle');

      themeToggle?.addEventListener('click', () => {
        const dark = !document.documentElement.classList.contains('dark');
        document.documentElement.classList.toggle('dark', dark);
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });

      // ── Language switcher ─────────────────────────────────────────
      const langToggle = document.getElementById('lang-toggle');
      const langMenu = document.getElementById('lang-menu');
      const langContainer = document.getElementById('lang-dropdown-container');

      langToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !langMenu?.classList.contains('hidden');
        langMenu?.classList.toggle('hidden');
        langToggle.setAttribute('aria-expanded', String(!isOpen));
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!langContainer?.contains(e.target as Node)) {
          langMenu?.classList.add('hidden');
          langToggle?.setAttribute('aria-expanded', 'false');
        }
      });

      // Language option click — reload with ?lang= param
      document.querySelectorAll<HTMLButtonElement>('.lang-option').forEach(btn => {
        btn.addEventListener('click', () => {
          const selectedLang = btn.dataset.lang;
          if (selectedLang) {
            const url = new URL(window.location.href);
            url.searchParams.set('lang', selectedLang);
            window.location.href = url.toString();
          }
        });
      });
    </script>
  </body>
</html>
